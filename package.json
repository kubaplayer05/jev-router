{
  "name": "jev-router",
  "version": "0.1.0",
  "description": "High-speed MCP routing, gating, and skills-orchestration server powered by Jev AI",
  "type": "module",
  "bin": {
    "jev-router": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx src/index.ts",
    "serve": "tsx --watch src/index.ts --http",
    "serve:dist": "node dist/index.js --http",
    "build": "tsup",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "jev",
    "typesafe",
    "agent",
    "router",
    "evaluator"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@typesafe-ai/sdk": "^0.6.0",
    "dotenv": "^18.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.5.5",
    "tsup": "^8.2.4",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}
