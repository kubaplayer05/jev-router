# Copy to .env and fill in values. See README Docker section.
TYPESAFE_API_KEY=
PORT=3333
HOST=0.0.0.0
# Optional: override deterministic retry gate
# JEV_MAX_RETRIES=5
# Docker compose: host path mounted at /workspace (pass working_directory=/workspace).
# HOST_WORKSPACE=/absolute/path/to/your/project
# Optional: host home mirrored at the identical path so host absolute
# working_directory values also resolve (defaults to $HOME, no hardcoded user).
# HOST_HOME=/home/your-user
